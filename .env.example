# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 파고쌤 기기(ESP32) 시리얼 포트. 적으면 아래 PC 장치 설정 대신 기기를 마이크/스피커로 쓴다.
# macOS 예: /dev/cu.usbserial-0001  /  Windows 예: COM8
PAGO_SERIAL_PORT=/dev/cu.usbserial-0001
# 기기 스피커 볼륨 0~100
PAGO_VOLUME=30

# 기기 없이 PC 마이크/스피커로 돌릴 때. 장치 이름 일부만 적어도 됨. 비워두면 시스템 기본 장치 사용.
PAGO_INPUT_DEVICE=GENERAL WEBCAM
PAGO_OUTPUT_DEVICE=

# 롤파고가 이벤트를 보낼 로컬 서버 포트
PAGO_PORT=8765

# 음성 인식 모델: small(약 0.9초, 오인식 많음) / medium(약 2.8초, 권장)
PAGO_WHISPER_MODEL=medium

# TTS 목소리 (ko-KR-SunHiNeural 여성 / ko-KR-InJoonNeural 남성)
PAGO_TTS_VOICE=ko-KR-SunHiNeural

# 말소리 감지 민감도. 주변 소음 대비 몇 배 커야 말로 볼지 (높을수록 둔감)
PAGO_VAD_RATIO=3.0
